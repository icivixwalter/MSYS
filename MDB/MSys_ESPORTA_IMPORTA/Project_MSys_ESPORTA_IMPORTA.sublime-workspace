o grande\n                if (fs.existsSync(LOG_FILE)) {\n                  const stats = fs.statSync(LOG_FILE);\n                  if (stats.size > LOG_MAX_SIZE) {\n                    const content = fs.readFileSync(LOG_FILE, 'utf8');\n                    const lines = content.split('\\n');\n                    const truncated = lines.slice(-500).join('\\n'); // Tieni ultime 500 righe\n                    fs.writeFileSync(LOG_FILE, truncated);\n                  }\n                }\n                \n                fs.appendFileSync(LOG_FILE, logEntry);\n                \n                // Mostra in console\n                console.log(`LOG ${level}: ${message}`);\n                \n                // Invia anche alla finestra UI se esiste\n                if (mainWindow && !mainWindow.isDestroyed()) {\n                  mainWindow.webContents.send('new-log-entry', {\n                    timestamp: new Date().toLocaleTimeString(),\n                    level: level,\n                    message: message\n                  });\n                }\n              } catch (err) {\n                console.error('Errore scrittura log:', err.message);\n              }\n            }\n            \n            function createWindow() {\n              logToFile('Creazione finestra BrowserWindow');\n              \n              mainWindow = new BrowserWindow({\n                width: 1400, // Più largo per mostrare i log\n                height: 800,\n                webPreferences: {\n                  nodeIntegration: true,\n                  contextIsolation: false,\n                  enableRemoteModule: true\n                }\n              });\n            \n              // Percorso dell'HTML\n              const htmlPath = path.join(__dirname, '..', 'renderer', 'appLLPP_index.html');\n              logToFile(`Cerco HTML in: ${htmlPath}`);\n            \n              if (fs.existsSync(htmlPath)) {\n                logToFile('SUCCESSO: File HTML trovato', 'SUCCESS');\n                mainWindow.loadFile(htmlPath).then(() => {\n                  logToFile('Pagina HTML caricata correttamente', 'SUCCESS');\n                }).catch(err => {\n                  logToFile(`ERRORE caricamento HTML: ${err.message}`, 'ERROR');\n                });\n              } else {\n                logToFile(`ERRORE CRITICO: File HTML non trovato in ${htmlPath}`, 'ERROR');\n                mainWindow.loadURL(`data:text/html,\n                  <!DOCTYPE html>\n                  <html>\n                  <head>\n                    <style>\n                      body { font-family: Arial; padding: 40px; background: #fff0f0; }\n                      h1 { color: #c00; }\n                      pre { background: #eee; padding: 15px; border-radius: 5px; }\n                    </style>\n                  </head>\n                  <body>\n                    <h1>Errore: File HTML non trovato</h1>\n                    <p>L'app cerca il file in: ${htmlPath}</p>\n                    <p><strong>Log salvato in:</strong> ${LOG_FILE}</p>\n                  </body>\n                  </html>\n                `);\n              }\n            \n              // Apri DevTools per debug\n              if (!app.isPackaged) {\n                mainWindow.webContents.openDevTools();\n              }\n            }\n            \n            // ========== IPC (Comunicazione con la finestra UI) ==========\n            \n            // Ricevi log dall'interfaccia utente\n            ipcMain.on('log-ui-event', (event, data) => {\n              logToFile(`${data.action}: ${data.details}`, 'UI');\n            });\n            \n            // Rispondi alla richiesta di percorso log\n            ipcMain.on('get-log-path', (event) => {\n              event.reply('log-path-response', LOG_FILE);\n            });\n            \n            // ========== AVVIO APP ==========\n            \n            app.whenReady().then(() => {\n              logToFile(`=== AVVIO APP ===`, 'INFO');\n              logToFile(`App: ${app.name} v${app.getVersion()}`, 'INFO');\n              logToFile(`Directory dati: ${app.getPath('userData')}`, 'INFO');\n              logToFile(`Modalità: ${app.isPackaged ? 'PRODUZIONE' : 'SVILUPPO'}`, 'INFO');\n              \n              createWindow();\n            });\n            \n            app.on('window-all-closed', () => {\n              logToFile('App in chiusura', 'INFO');\n              if (process.platform !== 'darwin') app.quit();\n            });\n            \n            app.on('quit', () => {\n              logToFile('=== APP CHIUSA ===', 'INFO');\n            });\n            \n            // Gestione errori\n            process.on('uncaughtException', (error) => {\n              logToFile(`ERRORE NON CATTURATO: ${error.message}`, 'CRITICAL');\n            });\n   html_old\n            <!DOCTYPE html>\n               <!-- ===============================================================================\n               STRUTTURA MASTER PAGE - SISTEMA GESTIONE LAVORI PUBBLICI MULTIMODULO\n                 ===================================================================================\n                 | Segnalibro                      | Descrizione                                   |\n                 |---------------------------      |-----------------------------------------------|\n                 | [SEZIONE_01_STYLE]              | Stili CSS principali                         |\n                 | [SEZIONE_02_MENU_LATERALE]      | Menu laterale con moduli                     |\n                 | [SEZIONE_03_HEADER]             | Header con titolo dinamico                   |\n                 | [SEZIONE_04_CONTENUTO_MAIN]     | Area contenitore moduli                      |\n                 | [SEZIONE_05_SCRIPT_MAIN]        | Script principale app.js                     |\n                 ================================================================================-->\n               <html 