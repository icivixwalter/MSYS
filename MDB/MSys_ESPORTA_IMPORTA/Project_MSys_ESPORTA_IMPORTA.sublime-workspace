ulo('modulo_07')\" data-modulo=\"modulo_07\">\n             <i class=\"fas fa-tools\"></i> Manutenzione\n           </a>\n\n           <a href=\"#\" onclick=\"caricaModulo('modulo_08')\" data-modulo=\"modulo_08\">\n             <i class=\"fas fa-truck\"></i> Gestione Fornitori\n           </a>\n\n           <a href=\"#\" onclick=\"caricaModulo('modulo_09')\" data-modulo=\"modulo_09\">\n             <i class=\"fas fa-calendar-alt\"></i> Calendario\n           </a>\n\n           <a href=\"#\" onclick=\"caricaModulo('modulo_10')\" data-modulo=\"modulo_10\">\n             <i class=\"fas fa-clipboard-list\"></i> Checklist\n           </a>\n\n           <a href=\"#\" onclick=\"caricaModulo('modulo_11')\" data-modulo=\"modulo_11\">\n             <i class=\"fas fa-chart-pie\"></i> Dashboard\n           </a>\n\n           <a href=\"#\" onclick=\"caricaModulo('modulo_12')\" data-modulo=\"modulo_12\">\n             <i class=\"fas fa-cog\"></i> Impostazioni\n           </a>\n         </div>\n         <!-- ==================== [FINE_SEZIONE_02_MENU_LATERALE] ==================== -->\n\n         <!-- ==================== [SEZIONE_03_HEADER] ==================== -->\n         <header>\n           <div class=\"header-left\">\n             <span class=\"menu-toggle\" onclick=\"toggleMenu()\">☰</span>\n             <h1 id=\"titoloHeader\">Gestione Lavori Pubblici</h1>\n           </div>\n\n           <!-- MODIFICA: Rimosso banner F11, mantenuto solo orologio -->\n           <div class=\"header-info\">\n             <span id=\"dataOra\"></span>\n           </div>\n\n         </header>\n         <!-- ==================== [FINE_SEZIONE_03_HEADER] ==================== -->\n\n         <!-- ==================== [SEZIONE_04_CONTENUTO_MAIN] ==================== -->\n         <div class=\"content\">\n           <!-- Area per il caricamento dinamico dei moduli -->\n           <div id=\"moduloContainer\">\n             <div class=\"loader\" id=\"loader\">\n               <div class=\"spinner\"></div>\n               <h3>Caricamento sistema...</h3>\n               <p>Seleziona un modulo dal menu laterale</p>\n             </div>\n           </div>\n         </div>\n         <!-- ==================== [FINE_SEZIONE_04_CONTENUTO_MAIN] ==================== -->\n\n         <!-- ==================== [SEZIONE_05_SCRIPT_MAIN] ==================== -->\n         <script src=\"app.js\"></script>\n\n         <!-- SISTEMA DI ADATTAMENTO AUTOMATICO AGGIUNTIVO -->\n         <script>\n         // Sistema di adattamento automatico per scrollbar\n         function adattaLayoutAllScrollbar() {\n           const content = document.querySelector('.content');\n           const moduloContainer = document.getElementById('moduloContainer');\n\n           if (!content || !moduloContainer) return;\n\n           // Controlla se c'è una scrollbar verticale\n           const hasVerticalScrollbar = content.scrollHeight > content.clientHeight;\n\n           // Applica classi in base alla presenza della scrollbar\n           if (hasVerticalScrollbar) {\n             content.classList.add('has-scrollbar');\n             // Calcola dinamicamente lo spazio per la scrollbar\n             const scrollbarWidth = content.offsetWidth - content.clientWidth;\n\n             // Se c'è scrollbar, assicurati che il contenuto non si sposti\n             if (scrollbarWidth > 0) {\n               // IMPORTANTE: Non aggiungiamo padding, ma usiamo box-sizing corretto\n               moduloContainer.style.width = '100%';\n               moduloContainer.style.boxSizing = 'border-box';\n             }\n           } else {\n             content.classList.remove('has-scrollbar');\n           }\n\n           // Sistema di rilevamento ridimensionamento finestra\n           let resizeTimer;\n           window.addEventListener('resize', function() {\n             clearTimeout(resizeTimer);\n             resizeTimer = setTimeout(function() {\n               adattaLayoutAllScrollbar();\n               // Forza ridisegno per evitare problemi di rendering\n               content.style.display = 'none';\n               content.offsetHeight; // Trigger reflow\n               content.style.display = '';\n             }, 250);\n           });\n\n           // Controlla anche quando il contenuto cambia\n           const observer = new MutationObserver(function(mutations) {\n             mutations.forEach(function(mutation) {\n               if (mutation.type === 'childList' || mutation.type === 'attributes') {\n                 setTimeout(adattaLayoutAllScrollbar, 100);\n               }\n             });\n           });\n\n           // Osserva cambiamenti nel contenuto\n           observer.observe(moduloContainer, {\n             childList: true,\n             subtree: true,\n             attributes: true\n           });\n         }\n\n         // Inizializza quando la pagina è pronta\n         document.addEventListener('DOMContentLoaded', function() {\n           // Piccolo delay per assicurarsi che tutto sia caricato\n           setTimeout(adattaLayoutAllScrollbar, 500);\n\n           // Controlla periodicamente (per moduli che caricano dinamicamente)\n           setInterval(adattaLayoutAllScrollbar, 1000);\n         });\n\n         // Esponi la funzione per uso esterno\n         window.adattaLayoutAllScrollbar = adattaLayoutAllScrollbar;\n         </script>\n         <!-- ==================== [FINE_SEZIONE_05_SCRIPT_MAIN] ==================== -->\n\n\n\n         <!-- ==================== [SEZIONE_06_LOGGING_SISTEMA] ==================== -->\n         <!-- Pannello log a video -->\n         <div id=\"log-panel\" style=\"\n           position: fixed;\n           bottom: 10px;\n           right: 10px;\n           width: 400px;\n           height: 200px;\n           background: rgba(0, 0, 0, 0.85);\n           color: #fff;\n           font-family: 'Courier New', monospace;\n           font-size: 12px;\n           padding: 10px;\n           border-radius: 5px;\n           z-index: 9999;\n           overflow-y: auto;\n           display: none;\n           border: 1px solid #555;\n         \">\n           <div style=\"display: flex; justify-content: space-between; margin-bottom: 5px;\">\n             <strong>Log Sistema</strong>\n             <button onclick=\"toggleLogPanel()\" style=\"background: #666; color: white; border: none; padding: 2px 8px; border-radius: 3px; cursor: pointer;\">X</button>\n           </div>\n           <div id=\"log-content\"></div>\n         </div>\n\n         <!-- Pulsante per mostrare/nascondere log -->\n         <button onclick=\"toggleLogPanel()\" style=\"\n           position: fixed;\n           bottom: 10px;\n           right: 10px;\n           background: #007acc;\n           color: white;\n           border: none;\n           padding: 5px 10px;\n           border-radius: 3px;\n           cursor: pointer;\n           z-index: 10000;\n           font-size: 11px;\n         \">📝 Log</button>\n\n         <script>\n         // ========== SISTEMA DI LOGGING ==========\n\n         // Elementi DOM\n         const logPanel = document.getElementById('log-panel');\n         const logContent = document.getElementById('log-content');\n         let isLogVisible = false;\n\n         // Mostra/nascondi pannello log\n         function toggleLogPanel() {\n           isLogVisible = !isLogVisible;\n           logPanel.style.display = isLogVisible ? 'block' : 'none';\n\n           // Logga l'azione\n           logUIAction('Pannello log', isLogVisible ? 'visibile' : 'nascosto');\n         }\n\n         // Aggiungi riga al log a video\n         function addLogToDisplay(level, message) {\n           const timestamp = new Date().toLocaleTimeString();\n           const levelColor = {\n             'INFO': '#4CAF50',\n             'SUCCESS': '#4CAF50',\n             'WARN': '#FF9800',\n             'ERROR': '#F44336',\n             'CRITICAL': '#9C27B0',\n             'UI': '#2196F3'\n           };\n\n           const logEntry = document.createElement('div');\n           logEntry.style.marginBottom = '3px';\n           logEntry.style.borderLeft = `3px solid ${levelColor[level] || '#666'}`;\n           logEntry.style.paddingLeft = '5px';\n           logEntry.innerHTML = `<span style=\"color: #aaa\">${timestamp}</span>\n                                <span style=\"color: ${levelColor[level] || '#666'}; font-weight: bold\">[${level}]</span>\n                                <span style=\"color: #fff\">${message}</span>`;\n\n           logContent.appendChild(logEntry);\n\n           // Auto-scroll\n           logPanel.scrollTop = logPanel.scrollHeight;\n\n           // Mantieni massimo 50 righe\n           if (logContent.children.length > 50) {\n             logContent.removeChild(logContent.firstChild);\n           }\n         }\n\n         // Logga azioni UI\n         function logUIAction(action, details = '') {\n           const message = `${action}: ${details}`.trim();\n           addLogToDisplay('UI', message);\n\n           // Invia al processo principale per salvare su file (se Electron è disponibile)\n           if (typeof electron !== 'undefined' && electron.ipcRenderer) {\n             electron.ipcRenderer.send('log-ui-event', {\n               action: action,\n               details: details\n             });\n           }\n\n           console.log(`UI Log: ${message}`);\n         }\n\n         // ========== TRACCIAMENTO AUTOMATICO ==========\n\n         // Traccia evento di caricamento pagina\n         document.addEventListener('DOMContentLoaded', function() {\n           // Attendi che l'app.js sia caricato\n           setTimeout(function() {\n             addLogToDisplay('INFO', 'Interfaccia utente caricata');\n             logUIAction('Pagina caricata', window.location.href);\n\n             // Traccia tutti i click sui link del menu\n             document.querySelectorAll('.sidebar a').forEach(link => {\n               link.addEventListener('click', function(event) {\n                 const modulo = this.getAttribute('data-modulo') || this.textContent.trim();\n                 logUIAction('Menu cliccato', `Modulo: ${modulo}`);\n               });\n             });\n\n             // Traccia apertura/chiusura menu\n             const menuToggle = document.querySelector('.menu-toggle');\n             if (menuToggle) {\n               menuToggle.addEventListener('click', function() {\n                 const sidebar = document.getElementById('sidebar');\n                 const isOpen = sidebar.classList.contains('open');\n                 logUIAction('Menu laterale', isOpen ? 'aperto' : 'chiuso');\n               });\n             }\n\n             // Traccia caricamento moduli (se la funzione caricaModulo esiste)\n             if (typeof caricaModulo === 'function') {\n               const originalCaricaModulo = caricaModulo;\n               window.caricaModulo = function(modulo) {\n                 logUIAction('Caricamento modulo', `Modulo: ${modulo}`);\n                 return originalCaricaModulo.apply(this, arguments);\n               };\n             }\n\n             // Traccia input nei campi di ricerca (se presenti)\n             document.querySelectorAll('input[type=\"search\"], input[placeholder*=\"cerca\"], input[placeholder*=\"Cerca\"]').forEach(input => {\n               input.addEventListener('change', function(event) {\n                 if (this.value.trim() !== '') {\n                   logUIAction('Ricerca eseguita', `Termine: \"${this.value.substring(0, 30)}${this.value.length > 30 ? '...' : ''}\"`);\n                 }\n               });\n             });\n           }, 100);\n         });\n\n         // ========== COMUNICAZIONE CON ELECTRON ==========\n\n         // Ricevi log dal processo principale Electron\n         if (typeof electron !== 'undefined' && electron.ipcRenderer) {\n           electron.ipcRenderer.on('new-log-entry', (event, data) => {\n             addLogToDisplay(data.level, data.message);\n           });\n\n           // Chiedi percorso del file log\n           electron.ipcRenderer.send('get-log-path');\n           electron.ipcRenderer.on('log-path-response', (event, path) => {\n             addLogToDisplay('INFO', `Log file: ${path}`);\n           });\n         }\n\n         // ========== UTILITY ==========\n\n         // Funzione per log manuale da altri script\n         window.appLogger = {\n           info: (msg) => addLogToDisplay('INFO', msg),\n           success: (msg) => addLogToDisplay('SUCCESS', msg),\n           warn: (msg) => addLogToDisplay('WARN', msg),\n           error: (msg) => addLogToDisplay('ERROR', msg),\n           ui: (action, details) => logUIAction(action, details),\n           togglePanel: toggleLogPanel\n         };\n\n         // Log iniziale\n         addLogToDisplay('INFO', 'Sistema di logging inizializzato');\n         addLogToDisplay('INFO', 'Pronto per tracciare le attività');\n\n         </script>\n         <!-- ==================== [FINE_SEZIONE_06_LOGGING_SISTEMA] ==================== -->\n\n         </body>\n         </html>\n\n   testo con debug\n      npm start\n   testo e creo eseguibile\n      npm run build-win\n\n\n     \n     \n### **FASE ?7: TEST INTEGRAZIONE** 🔄 *** DA FARE ***\n13. 🔄 Test avvio Electron con progetto HTML integrato\n14. 🔄 Debug eventuali errori di caricamento\n15. 🔄 Verifica funzionalità Node.js nel renderer\n\n---\n\n## 📋 **STEP FUTURI (DA PROGRAMMARE)**\n\n\n### **FASE 8: APRI FILE ACCESS**\n01. ⏳ Il menu principale \n\n\n### **FASE 8: OTTIMIZZAZIONE**\n16. ⏳ Configurazione menu applicazione\n17. ⏳ Impostazione icona applicazione\n18. ⏳ Configurazione build per distribuzione\n19. ⏳ Gestione finestre multiple (se necessario)\n\n### **FASE 9: FEATURES AVANZATE**\n20. ⏳ Integrazione con filesystem (Node.js)\n21. ⏳ Comunicazione IPC (main ↔ renderer)\n22. ⏳ Auto-update applicazione\n23. ⏳ Packaging per Windows (.exe)\n\n### **FASE 10: DOCUMENTAZIONE**\n24. ⏳ Creazione README completo\n25. ⏳ Documentazione API inter