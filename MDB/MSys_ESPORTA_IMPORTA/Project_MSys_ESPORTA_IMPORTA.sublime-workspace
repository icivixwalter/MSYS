   .menu-toggle {\n                     font-size: 28px;\n                     cursor: pointer;\n                     user-select: none;\n                     padding: 5px;\n                     border-radius: 4px;\n                     transition: background-color 0.2s;\n                   }\n               \n                   .menu-toggle:hover {\n                     background-color: rgba(255,255,255,0.1);\n                   }\n               \n                   #titoloHeader {\n                     font-size: 20px;\n                     margin: 0;\n                     font-weight: 600;\n                     text-align: center;\n                     flex: 1;\n                     padding: 0 20px;\n                   }\n               \n                   .header-info {\n                     font-size: 12px;\n                     opacity: 0.8;\n                     text-align: right;\n                     min-width: 300px;\n                   }\n               \n                   /* --- MENU LATERALE --- */\n                   .sidebar {\n                     position: fixed;\n                     top: 0;\n                     left: -250px;\n                     width: 250px;\n                     height: 100vh;\n                     background: linear-gradient(to bottom, #003366 0%, #004f7c 100%);\n                     color: white;\n                     padding-top: 80px;\n                     transition: left 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n                     z-index: 1000;\n                     overflow-y: auto;\n                     box-shadow: 2px 0 10px rgba(0,0,0,0.2);\n                   }\n               \n                   .sidebar.open {\n                     left: 0;\n                   }\n               \n                   .close-btn {\n                     position: absolute;\n                     top: 15px;\n                     left: 15px;\n                     font-size: 24px;\n                     cursor: pointer;\n                     padding: 5px;\n                     border-radius: 4px;\n                     transition: background-color 0.2s;\n                   }\n               \n                   .close-btn:hover {\n                     background-color: rgba(255,255,255,0.1);\n                   }\n               \n                   .sidebar a {\n                     display: flex;\n                     align-items: center;\n                     gap: 12px;\n                     padding: 15px 20px;\n                     text-decoration: none;\n                     color: white;\n                     border-bottom: 1px solid rgba(255,255,255,0.1);\n                     transition: all 0.2s;\n                     font-size: 15px;\n                   }\n               \n                   .sidebar a:hover {\n                     background-color: rgba(255,255,255,0.1);\n                     padding-left: 25px;\n                   }\n               \n                   .sidebar a i {\n                     font-size: 18px;\n                     width: 24px;\n                     text-align: center;\n                   }\n               \n                   .sidebar a.active {\n                     background-color: rgba(0,122,204,0.3);\n                     border-left: 4px solid #007acc;\n                     font-weight: bold;\n                   }\n               \n                   /* --- CONTENUTO PRINCIPALE --- */\n                   /* SISTEMA DI ADATTAMENTO AUTOMATICO: Area che si adatta automaticamente */\n                   /* Calcola dinamicamente lo spazio disponibile senza fissare larghezze */\n                   .content {\n                     margin: 60px 0 0 0; /* Solo margine superiore per l'header */\n                     height: calc(100vh - 60px);\n                     padding: 0;\n                     transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n                     background-color: #ffffff;\n                     overflow: auto;\n                     position: relative;\n                     /* Calcolo automatico: occupa tutto lo spazio disponibile */\n                     width: 100%;\n                     left: 0;\n                     right: 0;\n                   }\n               \n                   /* Quando il menu è aperto, si adatta automaticamente */\n                   .sidebar.open ~ .content {\n                     /* Calcolo dinamico: 100% - larghezza sidebar */\n                     width: calc(100% - 250px);\n                     margin-left: 250px;\n                   }\n               \n                   /* CONTENITORE MODULI: Adattamento perfetto senza margini */\n                   #moduloContainer {\n                     width: 100%;\n                     height: 100%;\n                     overflow: visible; /* Permette ai moduli di estendersi */\n                     background-color: #ffffff;\n                     /* Reset completo di tutti i margini/padding */\n                     margin: 0;\n                     padding: 0;\n                     border: 0;\n                     /* Sistema anti-scrollbar: compensa automaticamente */\n                     box-sizing: border-box;\n                   }\n               \n                   /* ADATTAMENTO PER IFRAME: Si espande completamente */\n                   .iframe-wrapper {\n                     width: 100%;\n                     height: 100%;\n                     overflow: visible;\n                     margin: 0;\n                     padding: 0;\n                   }\n               \n                   .iframe-container {\n                     width: 100%;\n                     height: 100%;\n                     overflow: auto;\n                     margin: 0;\n                     padding: 0;\n                     border: none;\n                   }\n               \n                   /* SISTEMA INTELLIGENTE: Adatta la scrollbar senza occupare spazio */\n                   .content::-webkit-scrollbar {\n                     width: 8px;\n                     background: transparent;\n                   }\n               \n                   .content::-webkit-scrollbar-track {\n                     background: transparent;\n                     margin: 0;\n                   }\n               \n                   .content::-webkit-scrollbar-thumb {\n                     background: #007acc;\n                     border-radius: 4px;\n                     border: 2px solid #ffffff; /* Crea spazio senza occuparlo */\n                   }\n               \n                   /* Quando c'è la scrollbar, il contenuto non si sposta */\n                   .content.has-scrollbar {\n                     padding-right: 0 !important; /* IMPORTANTE: non aggiunge padding */\n                   }\n               \n                   /* LOADER: Centrato ma senza influenzare il layout */\n                   .loader {\n                     display: flex;\n                     flex-direction: column;\n                     align-items: center;\n                     justify-content: center;\n                     height: 100%;\n                     color: #666;\n                     margin: 0;\n                     padding: 0;\n                     background-color: #ffffff;\n                   }\n               \n                   .spinner {\n                     width: 50px;\n                     height: 50px;\n                     border: 5px solid #f3f3f3;\n                     border-top: 5px solid #007acc;\n                     border-radius: 50%;\n                     animation: spin 1s linear infinite;\n                     margin-bottom: 20px;\n                   }\n               \n                   @keyframes spin {\n                     0% { transform: rotate(0deg); }\n                     100% { transform: rotate(360deg); }\n                   }\n               \n                   /* --- MESSAGGI DI ERRORE --- */\n                   .error-message {\n                     background-color: #ffebee;\n                     color: #c62828;\n                     padding: 20px;\n                     border-radius: 8px;\n                     margin: 20px;\n                     border-left: 4px solid #c62828;\n                   }\n               \n                   .error-message h3 {\n                     margin-top: 0;\n                     display: flex;\n                     align-items: center;\n                     gap: 10px;\n                   }\n               \n                   /* --- SISTEMA RESPONSIVE DINAMICO --- */\n                   @media (max-width: 768px) {\n                     .sidebar {\n                       width: 220px;\n                     }\n               \n                     .sidebar.open ~ .content {\n                       width: calc(100% - 220px);\n                       margin-left: 220px;\n                     }\n               \n                     .header-info {\n                       display: none;\n                     }\n                   }\n               \n                   @media (max-width: 480px) {\n                     #titoloHeader {\n                       font-size: 16px;\n                       padding: 0 10px;\n                     }\n               \n                     /* Su mobile piccolo, menu occupa tutto */\n                     @media (max-width: 320px) {\n                       .sidebar {\n                         width: 100%;\n                       }\n               \n                       .sidebar.open ~ .content {\n                         display: none; /* Su schermi piccolissimi, nascondi contenuto quando menu è aperto */\n                       }\n                     }\n                   }\n               \n                   /* SISTEMA DI DETECTION SCROLLBAR (JavaScript integrato) */\n                   /* Questo stile verrà applicato dinamicamente quando serve */\n                   .scrollbar-compensated {\n                     /* Quando la scrollbar è visibile, non cambia il layout */\n                     scrollbar-gutter: stable; /* Nuova proprietà CSS che gestisce lo spazio scrollbar */\n                   }\n               \n                   /* Per browser che supportano scrollbar-gutter */\n                   @supports (scrollbar-gutter: stable) {\n                     .content {\n                       scrollbar-gutter: stable;\n                     }\n                   }\n                 </style>\n                 <!-- ==================== [FINE_SEZIONE_01_STYLE] ==================== -->\n               </head>\n               <body>\n               \n               <!-- ==================== [SEZIONE_02_MENU_LATERALE] ==================== -->\n               <div id=\"sidebar\" class=\"sidebar\">\n                 <span class=\"close-btn\" onclick=\"toggleMenu()\">←</span>\n               \n                 <!-- Moduli principali -->\n                 <a href=\"#\" onclick=\"caricaModulo('telefono')\" data-modulo=\"telefono\">\n                   <i class=\"fas fa-phone\"></i> Rubrica Telefonica\n                 </a>\n               \n                 <a href=\"#\" onclick=\"caricaModulo('posta')\" data-modulo=\"posta\">\n                   <i class=\"fas fa-envelope\"></i> Gestione Posta\n                 </a>\n               \n                 <a href=\"#\" onclick=\"caricaModulo('presenze')\" data-modulo=\"presenze\">\n                   <i class=\"fas fa-user-clock\"></i> Presenze Dipendenti\n                 </a>\n               \n                 <a href=\"#\" onclick=\"caricaModulo('lavori_pubblici')\" data-modulo=\"lavori_pubblici\">\n                   <i class=\"fas fa-hard-hat\"></i> Lavori Pubblici\n                 </a>\n               \n                 <!-- Separatore -->\n                 <div style=\"padding: 15px 20px; color: rgba(255,255,255,0.5); font-size: 12px; text-transform: uppercase;\">\n                   Moduli Aggiuntivi\n                 </div>\n               \n                 <!-- Moduli aggiuntivi --