			"contents": "Dim frmProgress As Form_frmProgressBar ' Dichiarazione globale per il riferimento alla form\n\n'// APRE LA FORM DI PROGRESSO\nPublic Sub ApriProgressBar()\n    DoCmd.OpenForm \"frmProgressBar\", acNormal\n    DoEvents ' Aspetta che il form sia caricato\n    Set frmProgress = Forms(\"frmProgressBar\") ' Ottieni il riferimento al form\nEnd Sub\n\n'// AGGIORNA LA PROGRESS BAR\nPublic Sub AggiornaProgressBar(importedCount_i As Integer, NroCollection_i As Integer)\n    Dim progressValue_dbl As Double\n    Dim Twips_dbl As Double\n    Dim PercIncr_dbl As Double\n    Dim TipoImport_s As String\n    \n    ' Calcolo dei parametri\n    Twips_dbl = CInt(5670 / NroCollection_i)\n    PercIncr_dbl = (100 / NroCollection_i)\n    progressValue_dbl = progressValue_dbl + PercIncr_dbl\n    Dbl1 = Dbl1 + Twips_dbl\n    TipoImport_s = \"FORM IMPORTATE NRO : \" & importedCount_i\n    \n    ' Aggiorna la barra di progresso\n    frmProgress.AggiornaBarralabel progressValue_dbl, Dbl1, TipoImport_s\n    DoEvents ' Aggiorna interfaccia\nEnd Sub\n\n'// CHIUDE LA FORM CON RITARDO\nPublic Sub ChiudiProgressBar()\n    Dim T As Double\n    T = Timer\n    While Timer < T + 5\n        DoEvents\n    Wend\n    DoCmd.Close acForm, \"frmProgressBar\", acSaveNo\nEnd Sub\n\n\n\n\n\n\n\n\n'***********************************************************************************************************************\n\n'//======================================================================================================//'\n'//                         LA @PROGRESS@BAR  EVENTI'                         *** INIZIO ***\n'//======================================================================================================//'\n'//'\n'//EVENTI ED ATTIVITA _ '\n'//@PROGRESS@BAR@OPEN@DIM                       = DIM variabilie oggetto form _\n'//@PROGRESS@BAR@OPEN@FORM                      = APRI OGGETTO FORM _\n'//@PROGRESS@BAR@OPEN@UPDATE                    = AGGIORNA DATI PROGRESS BAR _\n'//@PROGRESS